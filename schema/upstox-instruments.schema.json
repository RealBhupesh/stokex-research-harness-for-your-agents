{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "STOCKEX read-only Upstox instrument mapping",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "instruments"],
  "properties": {
    "schema_version": {"const": 1},
    "instruments": {
      "type": "array", "minItems": 1, "maxItems": 5000,
      "items": {
        "oneOf": [
          {
            "type": "object", "additionalProperties": false,
            "required": ["type", "symbol", "isin", "series", "instrument_key"],
            "properties": {
              "type": {"const": "equity"},
              "symbol": {"type": "string", "pattern": "^[A-Z0-9][A-Z0-9&._-]{0,31}$"},
              "isin": {"type": "string", "pattern": "^IN[A-Z0-9]{9}[0-9]$"},
              "series": {"enum": ["EQ", "BE", "BZ", "SM", "ST"]},
              "instrument_key": {"type": "string", "pattern": "^NSE_EQ\\|IN[A-Z0-9]{9}[0-9]$", "description": "Runtime also requires the suffix to equal isin."}
            }
          },
          {
            "type": "object", "additionalProperties": false,
            "required": ["type", "index_name", "instrument_key"],
            "properties": {
              "type": {"const": "index"},
              "index_name": {"type": "string", "minLength": 1, "maxLength": 100},
              "instrument_key": {"type": "string", "pattern": "^NSE_INDEX\\|.+$"}
            }
          }
        ]
      }
    }
  }
}
